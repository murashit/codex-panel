language js

private pattern js_module_reference() {
  or {
    JsImport(),
    JsImportCallExpression()
  }
}

js_module_reference() as $stmt where {
  $stmt <: contains `$source` where { $source <: r"^[\"'](?:(?:\.\./)+ui|src/features/chat/ui)(?:/.*)?[\"']$" },
  register_diagnostic(span=$stmt, message="Chat host modules must not import chat UI directly; route rendering through panel-owned adapters.", severity="error")
}
