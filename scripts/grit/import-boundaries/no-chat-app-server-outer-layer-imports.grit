language js

private pattern js_module_reference() {
  or {
    JsImport(),
    JsImportCallExpression()
  }
}

js_module_reference() as $stmt where {
  $stmt <: contains `$source` where {
    $source <: r"^[\"'](?:(?:\.\./)+(?:host|panel|ui)|src/features/chat/(?:host|panel|ui))(?:/.*)?[\"']$"
  },
  register_diagnostic(span=$stmt, message="Chat app-server adapters must not import chat host, panel, or UI layers.", severity="error")
}
