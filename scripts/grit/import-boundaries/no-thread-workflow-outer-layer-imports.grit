language js

private pattern js_module_reference() {
  or {
    JsImport(),
    JsImportCallExpression()
  }
}

js_module_reference() as $stmt where {
  $stmt <: contains `$source` where {
    $source <: or {
      r"^[\"'](?:(?:\.\./)+(?:[^/\"']+/)*(?:app-server|host|ui)|src/(?:app-server|[^\"']*/(?:host|ui)))(?:/.*)?[\"']$",
      r"^[\"'](?:obsidian|preact(?:/.*)?)[\"']$",
      r"^[\"'].*\.(?:dom|measure|obsidian)(?:/.*)?[\"']$"
    }
  },
  register_diagnostic(span=$stmt, message="Thread workflows must depend on domain models and feature-owned ports instead of app-server, host, UI, Obsidian, or DOM bridge modules.", severity="error")
}
