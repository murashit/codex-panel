language js

private pattern js_module_reference() {
  or {
    JsImport(),
    JsImportCallExpression()
  }
}

private pattern generated_app_server_source() { r"^[\"'].*(?:src/)?generated/app-server(?:/.*)?[\"']$" }

js_module_reference() as $stmt where {
  $stmt <: contains `$source` where { $source <: generated_app_server_source() },
  register_diagnostic(span=$stmt, message="Import generated app-server types only in connection, protocol converters, and Chat inbound adapters; expose Panel-owned models to application and UI.", severity="error")
}
