language js

private pattern js_module_reference() {
  or {
    JsImport(),
    JsImportCallExpression()
  }
}

js_module_reference() as $stmt where {
  $stmt <: contains `$source` where {
    $source <: r"^[\"'](?:(?:[^\"']*/)?features/[^./\"'][^/\"']*/domain|(?:\.\./)+[^./\"'][^/\"']*/domain)(?:/[^\"']*)?[\"']$"
  },
  register_diagnostic(span=$stmt, message="Feature domain modules are feature-local; move cross-feature vocabulary to src/domain or expose a feature contract.", severity="error")
}
