language js

private pattern js_module_reference() {
  or {
    JsImport(),
    JsImportCallExpression()
  }
}

js_module_reference() as $stmt where {
  $stmt <: contains `$source` where { $source <: r"^[\"'](?:(?:\.\./)+app-server|src/app-server)(?:/.*)?[\"']$" },
  register_diagnostic(span=$stmt, message="Thread workflows must depend on domain models and feature-owned ports instead of app-server modules.", severity="error")
}
