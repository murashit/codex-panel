language js

JsxAttribute(name=$name) as $stmt where {
  or { $name <: `defaultValue`, $name <: `defaultChecked` },
  $stmt <: within or {
    JsxSelfClosingElement(name=$tag),
    JsxOpeningElement(name=$tag)
  } where {
    $tag <: or {
      `input`,
      `select`,
      `textarea`
    }
  } ,
  register_diagnostic(span=$stmt, message="Keep native Preact form state explicit with controlled value or checked props.", severity="error")
}
