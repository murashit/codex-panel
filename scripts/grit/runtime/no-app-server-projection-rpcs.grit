language js

or {
  `$client.request("thread/resume", $...)` as $stmt,
  `$client.request("thread/turns/list", $...)` as $stmt,
  `$client.request("thread/fork", $...)` as $stmt,
  `$client.request("thread/rollback", $...)` as $stmt
} where {
  $client <: r"^(?:client|[A-Za-z_$][A-Za-z0-9_$]*Client)$",
  register_diagnostic(span=$stmt, message="Keep app-server projection RPCs behind app-server facades; consume Panel-owned snapshots or view models here.", severity="error")
}
