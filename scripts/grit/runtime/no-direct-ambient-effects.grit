language js

or {
  `Date.now()` as $stmt,
  `new Date()` as $stmt,
  `Math.random()` as $stmt,
  `new AppServerClient($...)` as $stmt,
  `new ConnectionManager($...)` as $stmt,
  `new Notice($...)` as $stmt,
  `setTimeout($...)` as $stmt,
  `clearTimeout($...)` as $stmt,
  `requestAnimationFrame($...)` as $stmt,
  `document.$property` as $stmt,
  `localStorage.$property` as $stmt,
  `sessionStorage.$property` as $stmt
} where {
  register_diagnostic(span=$stmt, message="Keep direct ambient time, randomness, resource construction, scheduling, and browser globals out of state, fact, and projection modules.", severity="error")
}
