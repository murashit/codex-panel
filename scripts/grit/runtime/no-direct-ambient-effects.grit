language js

or {
  // Reject references too: passing Date.now or Math.random still introduces an ambient effect.
  `Date.now` as $stmt,
  `Date()` as $stmt,
  `new Date()` as $stmt,
  `Math.random` as $stmt,
  `performance.now` as $stmt,
  `crypto.randomUUID` as $stmt,
  `crypto.getRandomValues` as $stmt,
  `new AppServerClient($...)` as $stmt,
  `new ConnectionManager($...)` as $stmt,
  `new Notice($...)` as $stmt,
  `setTimeout($...)` as $stmt,
  `clearTimeout($...)` as $stmt,
  `setInterval($...)` as $stmt,
  `clearInterval($...)` as $stmt,
  `requestAnimationFrame($...)` as $stmt,
  `cancelAnimationFrame($...)` as $stmt,
  `fetch($...)` as $stmt,
  `document.$property` as $stmt,
  `localStorage.$property` as $stmt,
  `sessionStorage.$property` as $stmt,
  `$global.Date.now` as $stmt where {
    $global <: or {
      `window`,
      `globalThis`
    }
  },
  `new $global.Date()` as $stmt where {
    $global <: or {
      `window`,
      `globalThis`
    }
  },
  `$global.Math.random` as $stmt where {
    $global <: or {
      `window`,
      `globalThis`
    }
  },
  `$global.$property` as $stmt where {
    $global <: or {
      `window`,
      `globalThis`
    },
    $property <: r"^(?:document|localStorage|sessionStorage|performance|crypto|fetch|setTimeout|clearTimeout|setInterval|clearInterval|requestAnimationFrame|cancelAnimationFrame)$"
  }
} where {
  register_diagnostic(span=$stmt, message="Keep ambient time, randomness, I/O, resource construction, and scheduling out of domain, state, fact, and projection modules; pass boundary observations as data.", severity="error")
}
