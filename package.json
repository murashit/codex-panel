{
  "name": "codex-panel",
  "version": "5.9.7",
  "description": "Codex in your Obsidian sidebar.",
  "main": "main.js",
  "author": "murashit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murashit/codex-panel.git"
  },
  "bugs": {
    "url": "https://github.com/murashit/codex-panel/issues"
  },
  "homepage": "https://github.com/murashit/codex-panel#readme",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "api:baseline": "node scripts/api-baseline.mjs",
    "build": "node esbuild.config.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "commitlint": "commitlint",
    "check": "concurrently --group --pad-prefix 'node:check:*' && node --run build",
    "check:biome": "biome check --diagnostic-level=info --error-on-warnings",
    "check:css-usage": "node scripts/check-css-usage.mjs",
    "check:eslint": "eslint src manifest.json LICENSE --max-warnings=0",
    "check:test": "node --run test",
    "check:typecheck": "node --run typecheck",
    "check:unused": "knip --no-progress",
    "fix": "biome check --fix --skip=plugin --diagnostic-level=info --error-on-warnings && knip --fix --no-progress",
    "generate:app-server-types": "node scripts/generate-app-server-types.mjs",
    "generate:app-server-types:check": "node scripts/check-app-server-type-normalization.mjs && node scripts/generate-app-server-types.mjs --check",
    "release:check": "node scripts/release/check.mjs",
    "release:notes": "node scripts/release/notes.mjs",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "test": "vitest run",
    "test:policies": "node scripts/check-grit-policies.mjs",
    "test:order": "vitest run --maxWorkers 1 --sequence.shuffle",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typescript/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "conventional-commits-parser": "^7.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "moment": "^2.31.0",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.104.0",
    "defuddle": "^0.19.4",
    "diff": "^9.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.3",
    "micromark": "^4.0.3",
    "obsidian-daily-notes-interface": "^0.9.5",
    "preact": "^11.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    }
  }
}
