{
  "name": "codex-panel",
  "version": "5.13.0",
  "description": "Codex in your Obsidian sidebar.",
  "main": "main.js",
  "author": "murashit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murashit/codex-panel.git"
  },
  "bugs": {
    "url": "https://github.com/murashit/codex-panel/issues"
  },
  "homepage": "https://github.com/murashit/codex-panel#readme",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "api:baseline": "node scripts/api-baseline.mjs",
    "build": "node esbuild.config.mjs",
    "build:styles": "node scripts/styles/build.mjs",
    "commitlint": "commitlint",
    "check": "concurrently --group --pad-prefix 'node:check:*' 'node:typecheck' 'node:test' && node --run build",
    "check:biome": "biome check --diagnostic-level=info --error-on-warnings",
    "check:css-usage": "node scripts/styles/check-usage.mjs",
    "check:eslint": "eslint src tests manifest.json LICENSE --max-warnings=0",
    "check:unused": "knip --no-progress",
    "fix": "biome check --fix --skip=plugin --diagnostic-level=info --error-on-warnings && knip --fix --no-progress",
    "generate:app-server-types": "node scripts/app-server/generate-types.mjs",
    "generate:app-server-types:check": "node scripts/app-server/check-type-normalization.mjs && node scripts/app-server/generate-types.mjs --check",
    "release:check": "node scripts/release/check.mjs",
    "test": "vitest run",
    "test:policies": "node scripts/grit/check.mjs",
    "test:order": "vitest run --maxWorkers 1 --sequence.shuffle",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typescript/tsconfig.tsbuildinfo",
    "review:duplication": "jscpd src tests --ignore \"**/src/generated/**,src/generated/**\" --reporters console,json --output reports/duplication"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "^4.10.2",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "moment": "^2.31.0",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.104.5",
    "defuddle": "^0.19.5",
    "diff": "^9.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "micromark": "^4.0.3",
    "obsidian-daily-notes-interface": "^0.9.5",
    "preact": "^11.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    }
  }
}
