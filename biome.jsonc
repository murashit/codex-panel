{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "plugins": [
    // Project-wide source shape and placement.
    {
      "path": "./scripts/grit/source-shape/no-handwritten-reexports.grit",
      "includes": ["**/*.{ts,tsx,mjs}"]
    },
    {
      "path": "./scripts/grit/source-shape/no-uncontrolled-preact-form-state.grit",
      "includes": ["**/src/**/*.tsx"]
    },

    // Cross-cutting source-layer import boundaries.
    {
      "path": "./scripts/grit/import-boundaries/no-domain-outer-layer-imports.grit",
      "includes": ["**/src/domain/**/*.{ts,tsx}", "**/src/features/*/domain/**/*.{ts,tsx}"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-core-outer-layer-imports.grit",
      "includes": ["**/src/app-server/**/*.{ts,tsx}", "**/src/shared/**/*.{ts,tsx}"]
    },

    // App-server and generated protocol boundaries.
    {
      "path": "./scripts/grit/import-boundaries/no-app-server-connection-boundary-imports.grit",
      "includes": [
        "**/src/app-server/protocol/**/*.{ts,tsx}",
        "**/src/domain/**/*.{ts,tsx}",
        "**/src/shared/**/*.{ts,tsx}",
        "**/src/features/selection-rewrite/**/*.{ts,tsx}"
      ]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-external-app-server-query-imports.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/app-server/query/**", "!**/src/execution-runtime.ts"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-app-server-protocol-boundary-imports.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/app-server/**", "!**/src/features/chat/app-server/mappers/thread-stream/turn-items.ts"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-chat-turn-item-non-turn-protocol-imports.grit",
      "includes": ["**/src/features/chat/app-server/mappers/thread-stream/turn-items.ts"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-generated-app-server-boundary-imports.grit",
      "includes": [
        "**/src/**/*.{ts,tsx}",
        "!**/src/app-server/connection/**",
        "!**/src/app-server/protocol/**",
        "!**/src/features/chat/app-server/inbound/**"
      ]
    },
    {
      "path": "./scripts/grit/runtime/no-app-server-direct-rpcs.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/app-server/**", "!**/src/features/chat/app-server/**"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-query-cache-imports.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/app-server/query/**"]
    },
    // Workspace and feature coordination boundaries.
    {
      "path": "./scripts/grit/import-boundaries/no-feature-workspace-boundary-imports.grit",
      "includes": ["**/src/features/**/*.{ts,tsx}"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-external-feature-domain-imports.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/features/*/domain/**"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-workspace-chat-internal-imports.grit",
      "includes": ["**/src/workspace/**/*.{ts,tsx}"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-thread-workflow-outer-layer-imports.grit",
      "includes": ["**/src/features/threads/workflows/**/*.{ts,tsx}"]
    },

    // Chat feature layer boundaries.
    {
      "path": "./scripts/grit/import-boundaries/no-chat-application-outer-layer-imports.grit",
      "includes": ["**/src/features/chat/application/**/*.{ts,tsx}"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-chat-app-server-outer-layer-imports.grit",
      "includes": ["**/src/features/chat/app-server/**/*.{ts,tsx}"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-chat-host-presentation-app-server-imports.grit",
      "includes": ["**/src/features/chat/host/{composer,goal,runtime,shell,thread-stream,toolbar}/**/*.{ts,tsx}"]
    },
    {
      "path": "./scripts/grit/import-boundaries/no-chat-ui-outer-layer-imports.grit",
      "includes": ["**/src/features/chat/ui/**/*.{ts,tsx}"]
    },

    // Domain calculations, state transitions, facts, and projections consume effects as data.
    {
      "path": "./scripts/grit/runtime/no-direct-ambient-effects.grit",
      "includes": [
        "**/src/domain/**/*.{ts,tsx}",
        "**/src/features/*/domain/**/*.{ts,tsx}",
        "**/src/features/chat/application/state/**/*.{ts,tsx}",
        "**/src/**/*-facts.{ts,tsx}",
        "**/src/**/*-projection.{ts,tsx}"
      ]
    },

    // Workflows exchange values and actions, not browser elements.
    {
      "path": "./scripts/grit/dom/no-workflow-dom-handles.grit",
      "includes": [
        "**/src/domain/**/*.{ts,tsx}",
        "**/src/features/*/domain/**/*.{ts,tsx}",
        "**/src/features/chat/application/**/*.{ts,tsx}",
        "**/src/features/threads/workflows/**/*.{ts,tsx}"
      ]
    },

    // Preact root cleanup has one owner.
    {
      "path": "./scripts/grit/dom/no-preact-root-api-imports.grit",
      "includes": ["**/src/**/*.{ts,tsx}", "!**/src/shared/ui/preact-root.dom.tsx"]
    },

    // CSS source policy.
    {
      "path": "./scripts/grit/no-restricted-css-policy.grit",
      "includes": ["**/src/styles/**/*.css"]
    }
  ],
  "files": {
    "includes": [
      "*.config.mjs",
      "*.config.{ts,mts}",
      "*.css",
      "*.json",
      "*.jsonc",
      "*.mjs",
      "scripts/**/*.{json,jsonc}",
      "scripts/**/*.grit",
      "scripts/**/*.mjs",
      "src/**/*.{css,ts,tsx}",
      "tests/**/*.{mjs,ts,tsx}",
      "!src/generated"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 140
  },
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        // TypeScript noPropertyAccessFromIndexSignature requires brackets for unknown record keys.
        "useLiteralKeys": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // Explicit invalidation keys may intentionally refresh effects without being read in the closure.
            "reportUnnecessaryDependencies": false
          }
        }
      },
      "nursery": {
        "noExcessiveSelectorClasses": {
          "level": "error",
          "options": {
            "maxClasses": 4
          }
        }
      },
      "style": {
        "noCommonJs": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  }
}
